{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trygantry.dev/schemas/schema-manifest.schema.json",
  "title": "Gantry Published Schema Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "compatibility", "contracts"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "compatibility": {
      "enum": ["exact_version_fail_closed"]
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "current_version", "authority"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^[a-z0-9-]+\\.schema\\.json$" },
          "current_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "authority": { "enum": ["governance_record", "derived_artifact", "configuration"] }
        }
      }
    }
  }
}
