{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trygantry.dev/schemas/mobile-release.schema.json",
  "title": "Gantry Mobile Workflow Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "name",
    "owner",
    "stage",
    "created_at",
    "updated_at",
    "candidate_ids",
    "active_candidates",
    "audit_ids",
    "active_audits",
    "evidence_link_ids",
    "resolution_ids",
    "decision_ids",
    "active_decisions",
    "waiver_ids",
    "active_waiver_ids",
    "latest_event_sequence",
    "latest_event_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^REL-[A-F0-9]{10}$" },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": ["string", "null"], "minLength": 1 },
    "owner": { "type": ["string", "null"], "minLength": 1 },
    "target_date": { "type": ["string", "null"], "format": "date" },
    "submission_date": { "type": ["string", "null"], "format": "date" },
    "rollout_date": { "type": ["string", "null"], "format": "date" },
    "stage": {
      "enum": [
        "draft",
        "candidate",
        "in_review",
        "approved",
        "rejected",
        "submitted",
        "rolling_out",
        "released",
        "halted",
        "superseded"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CAN-[A-F0-9]{10}$" }
    },
    "active_candidates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ios": { "type": "string", "pattern": "^CAN-[A-F0-9]{10}$" },
        "android": { "type": "string", "pattern": "^CAN-[A-F0-9]{10}$" }
      }
    },
    "audit_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^AUD-[A-F0-9]{10}$" }
    },
    "active_audits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ios": { "type": "string", "pattern": "^AUD-[A-F0-9]{10}$" },
        "android": { "type": "string", "pattern": "^AUD-[A-F0-9]{10}$" }
      }
    },
    "evidence_link_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^LNK-[A-F0-9]{10}$" }
    },
    "resolution_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^RES-[A-F0-9]{10}$" }
    },
    "decision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^DEC-[A-F0-9]{10}$" }
    },
    "active_decisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ios": { "type": "string", "pattern": "^DEC-[A-F0-9]{10}$" },
        "android": { "type": "string", "pattern": "^DEC-[A-F0-9]{10}$" }
      }
    },
    "waiver_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^WAV-[A-F0-9]{10}$" }
    },
    "active_waiver_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^WAV-[A-F0-9]{10}$" }
    },
    "latest_event_sequence": { "type": "integer", "minimum": 1 },
    "latest_event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
