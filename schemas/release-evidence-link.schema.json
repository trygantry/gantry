{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trygantry.dev/schemas/release-evidence-link.schema.json",
  "title": "Gantry Candidate Evidence Link",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "evidence_id",
    "evidence_digest",
    "release_id",
    "candidate_id",
    "source_audit_id",
    "platform",
    "finding_instance_id",
    "mobile_evidence_kind",
    "actor",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^LNK-[A-F0-9]{10}$" },
    "evidence_id": { "type": "string", "pattern": "^EVI-[A-F0-9]{10}$" },
    "evidence_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "release_id": { "type": "string", "pattern": "^REL-[A-F0-9]{10}$" },
    "candidate_id": { "type": "string", "pattern": "^CAN-[A-F0-9]{10}$" },
    "source_audit_id": { "type": "string", "pattern": "^AUD-[A-F0-9]{10}$" },
    "platform": { "enum": ["ios", "android"] },
    "finding_instance_id": { "type": "string", "minLength": 1 },
    "mobile_evidence_kind": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "actor": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
