{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trygantry.dev/schemas/release-candidate-diff.schema.json",
  "title": "Gantry Release Candidate Diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_id", "platform", "from_candidate", "to_candidate",
    "artifact_size_delta_bytes", "git_commit_changed", "from_audit", "to_audit",
    "automated_decision_changed", "policy_changed", "introduced_findings",
    "resolved_findings", "changed_findings", "related_events"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "release_id": { "type": "string", "pattern": "^REL-[A-F0-9]{10}$" },
    "platform": { "enum": ["ios", "android"] },
    "from_candidate": { "type": "object" },
    "to_candidate": { "type": "object" },
    "artifact_size_delta_bytes": { "type": "integer" },
    "git_commit_changed": { "type": "boolean" },
    "from_audit": { "type": ["object", "null"] },
    "to_audit": { "type": ["object", "null"] },
    "automated_decision_changed": { "type": "boolean" },
    "policy_changed": { "type": "boolean" },
    "introduced_findings": { "$ref": "#/$defs/finding_deltas" },
    "resolved_findings": { "$ref": "#/$defs/finding_deltas" },
    "changed_findings": { "$ref": "#/$defs/finding_deltas" },
    "related_events": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "finding_deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_instance_id", "title", "from_status", "to_status",
          "from_severity", "to_severity"
        ],
        "properties": {
          "finding_instance_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "from_status": { "enum": ["pass", "fail", "warning", "manual", "unavailable", null] },
          "to_status": { "enum": ["pass", "fail", "warning", "manual", "unavailable", null] },
          "from_severity": { "enum": ["blocker", "warning", "advisory", null] },
          "to_severity": { "enum": ["blocker", "warning", "advisory", null] }
        }
      }
    }
  }
}
