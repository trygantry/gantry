{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trygantry.dev/schemas/release-finding-waiver.schema.json",
  "title": "Gantry Release Finding Waiver",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "release_id", "candidate_id", "candidate_sha256", "audit_id", "platform",
    "report_fingerprint", "policy_digest", "finding_instance_id", "reason", "approved_by", "created_at",
    "expires_at", "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^WAV-[A-F0-9]{10}$" },
    "release_id": { "type": "string", "pattern": "^REL-[A-F0-9]{10}$" },
    "candidate_id": { "type": "string", "pattern": "^CAN-[A-F0-9]{10}$" },
    "candidate_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "audit_id": { "type": "string", "pattern": "^AUD-[A-F0-9]{10}$" },
    "platform": { "enum": ["ios", "android"] },
    "report_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policy_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finding_instance_id": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "approved_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "const": "active" }
  }
}
